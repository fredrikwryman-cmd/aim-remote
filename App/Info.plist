<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleDisplayName</key><string>Tech Rabbit Remote</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key><string>Tech Rabbit Remote</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>UILaunchScreen</key><dict/>
    <key>UIApplicationSceneManifest</key><dict>
        <key>UIApplicationSupportsMultipleScenes</key><false/>
    </dict>
    <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
    <key>UIUserInterfaceStyle</key><string>Dark</string>
    <key>NSLocalNetworkUsageDescription</key><string>Tech Rabbit Remote använder ditt lokala nätverk för att hitta och styra din TV.</string>
    <key>NSBonjourServices</key><array><string>_androidtvremote2._tcp</string></array>
    <key>NSMicrophoneUsageDescription</key><string>Tech Rabbit Remote skickar din röst till TV:n när du startar mikrofonen.</string>
    <key>ITSAppUsesNonExemptEncryption</key><false/>
    <!-- Widgetens yta oppnar techrabbit://remote. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key><string>Editor</string>
            <key>CFBundleURLName</key><string>se.aim.remote</string>
            <key>CFBundleURLSchemes</key><array><string>techrabbit</string></array>
        </dict>
    </array>
    <key>UIAppFonts</key>
    <array>
        <string>Archivo-Regular.ttf</string>
        <string>Archivo-Medium.ttf</string>
        <string>Archivo-SemiBold.ttf</string>
        <string>Archivo-Bold.ttf</string>
        <string>Archivo-ExtraBold.ttf</string>
        <string>Archivo-Black.ttf</string>
    </array>
</dict></plist>
